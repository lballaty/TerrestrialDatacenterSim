{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "meta": {
  "target": "Terrestrial AI Data Center Siting and Economics Model",
  "url": "https://<owner>.github.io/TerrestrialDatacenterSim/",
  "app_version_at_authoring": "v0.4",
  "catalog_version": "1.0.0",
  "authored": "2026-09-05",
  "author": "Test plan generated for Libor Ballaty (Arion Networks s.r.o.)",
  "status": "Draft for Review",
  "purpose": "Executable spec an LLM/browser agent follows to verify 100% of actions, dropdowns, inputs, modals and readouts in the app AND that the numbers produced are physically/economically reasonable.",
  "companion_doc": "TerrestrialDatacenterSim-test-plan.md",
  "notes": [
   "Single-file client-side HTML calculator; no server round-trip. Always click Recalculate (#calc) before reading KPIs for determinism.",
   "Control DOM ids are stable and equal data-test-id. If an id is not found, re-enumerate the DOM and log DRIFT.",
   "The power mix is dynamic: rows mixOpt{i}/mixMW{i}/mixOrd{i}/mixDel{i} are created by the template engine; the manifest lists the template select and add button, and the reconciler treats per-row ids as dom_only INFO, not failures.",
   "The app auto-loads data/*.json on a served origin; on file:// it uses embedded presets. Tests state which mode they assume."
  ]
 },
 "runner_protocol": {
  "io_primitives": {
   "setNum": "el=byId(id); el.value=String(v); dispatch input+change",
   "setSel": "el=byId(id); el.value=v; dispatch change",
   "recalc": "byId('calc').click()",
   "kpi": "byId(id).textContent.trim()",
   "editable": "!(el.disabled||el.readOnly||el.offsetParent===null)"
  },
  "determinism": "Force #calc before every read; #reset between destructive suites.",
  "result_kpi_ids": [
   "tok",
   "capexMW",
   "kwmo",
   "ttp",
   "pueMW",
   "gpuh",
   "env",
   "avail"
  ],
  "self_heal": "On missing id, re-enumerate inputs/selects/buttons; log DRIFT(old->new) or MISSING.",
  "coverage_target": "100% of control_registry entries + all reasonableness_rules run."
 },
