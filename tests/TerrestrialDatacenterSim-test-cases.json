 "tag_contract": {
  "purpose": "Every interactive element and readout carries data-test-* attributes so the UI is self-describing; rich detail lives here keyed by the same id; reconcile.js proves they agree.",
  "attribute_prefix": "data-test-",
  "id_rule": "data-test-id (controls) / data-test-out (readouts) MUST equal the DOM id.",
  "required_on_every_interactive_element": [
   "data-test-id",
   "data-test-kind",
   "data-test-tab",
   "data-test-label"
  ],
  "required_on_every_readout": [
   "data-test-out (= id) OR data-test-id",
   "data-test-kind='readout'",
   "data-test-tab",
   "data-test-label"
  ],
