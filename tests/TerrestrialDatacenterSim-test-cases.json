 "test_suites": [
  {
   "id": "S1",
   "name": "Smoke / load",
   "proves": "App loads, no console errors, KPIs render.",
   "type": "functional"
  },
  {
   "id": "S2",
   "name": "Tab navigation",
   "parametric_over": "control_registry.tabs",
   "proves": "All 7 tabs reveal their controls."
  },
  {
   "id": "S3",
   "name": "Numeric inputs",
   "parametric_over": "control_registry.numeric_inputs",
   "per_input_cases": [
    {
     "id": "nominal",
     "action": "set default, recalc",
     "expect": "KPIs recompute, no error"
    },
    {
     "id": "low",
     "action": "set min or min+step, recalc",
     "expect": "accepted, no NaN, cautions recorded"
    },
    {
     "id": "high",
     "action": "set default×10, recalc",
     "expect": "finite KPIs, direction matches rule if any"
    },
    {
     "id": "invalid_neg",
     "action": "set -1, recalc",
     "expect": "clamped or flagged, never NaN"
    },
    {
     "id": "invalid_text",
     "action": "set 'abc', recalc",
     "expect": "treated as 0/ignored, never NaN"
    },
    {
     "id": "restore",
     "action": "reset field",
     "expect": "baseline restored"
    }
   ],
   "type": "functional+validity"
  },
  {
   "id": "S4",
   "name": "Dropdowns",
   "parametric_over": "control_registry.selects",
   "proves": "Every option applies and unlocks/locks the right fields."
  },
  {
   "id": "S5",
   "name": "Cooling & PUE",
   "proves": "Each cooling architecture sets its cap and overhead; derived vs manual PUE toggle works (R9,R10,R11)."
  },
  {
   "id": "S6",
   "name": "Power mix & templates",
   "proves": "Each of the 7 templates builds an eligible mix; rows editable; add/delete work; LCOE and dispatch tables render (R12–R16).",
   "type": "functional+validity"
  },
  {
   "id": "S7",
   "name": "Modals",
   "proves": "Specification (render + own-window + file fallback), Break-even (every beTarget×beGoal), Self-tests all-pass."
  },
  {
   "id": "S8",
   "name": "Global actions",
   "proves": "Recalculate, Reset→baseline, Download round-trip, custom-site save/export/import (R22,R23)."
  },
  {
   "id": "S9",
   "name": "Reasonableness",
   "parametric_over": "reasonableness_rules",
   "proves": "All 25 physics/economics/text rules hold on baseline and perturbations.",
   "type": "validity"
  },
  {
   "id": "S10",
