 ],
 "reasonableness_rules": [
  {
   "id": "R1",
   "name": "No NaN/Infinity/blank",
   "check": "After any valid input, every KPI readout (tok,capexMW,kwmo,ttp,pueMW,gpuh,env,avail) renders a finite value; no 'NaN','Infinity','','undefined','$NaN'.",
   "severity": "critical"
  },
  {
   "id": "R2",
   "name": "Non-negative economics",
   "check": "tok, capexMW, kwmo, gpuh ≥ 0 for any physically valid scenario.",
   "severity": "critical"
  },
  {
   "id": "R3",
   "name": "Baseline anchor",
   "check": "Reset + US-VA grid template reproduces the oracle table within ±2% (sign/structure exact).",
   "severity": "high"
  },
  {
   "id": "R4",
   "name": "Parity self-test",
   "check": "The in-file 'Orbital parity' self-test yields $0.247/1M tokens ±0.2% under the stub inputs. Authoritative over the oracle if they disagree.",
   "severity": "critical"
  },
  {
   "id": "R5",
   "name": "Composition self-test",
   "check": "The §10.2 stack at US-avg, Tier III, air, grid-only composes to ~$12M/MW IT ±5%.",
   "severity": "high"
  },
  {
   "id": "R6",
   "name": "Unit-count derivation",
   "check": "installed units = ceil(mw*1000/rkw) then +spare%; IT MW = units*rkw/1000*(1+itoh); moves monotonically with mw and rkw.",
   "severity": "high"
  },
  {
   "id": "R7",
   "name": "Utilization drives token cost down",
   "check": "↑util lowers tok; ↑tpsmw lowers tok; both monotone.",
   "severity": "high"
  },
  {
   "id": "R8",
   "name": "Tariff & compute cost drive token cost up",
   "check": "↑tariff, ↑rcost, ↑disc each raise tok.",
   "severity": "high"
  },
  {
   "id": "R9",
   "name": "Derived PUE bounds",
   "check": "When pueMode=derived, 1.0 < PUE < 2.0 for all cooling architectures; ↑free-cooling fraction lowers PUE.",
   "severity": "high"
  },
  {
   "id": "R10",
   "name": "PUE·facility MW consistency",
   "check": "facility MW = IT MW × PUE; pueMW readout equals the two multiplied.",
   "severity": "medium"
  },
  {
   "id": "R11",
   "name": "Cooling architecture cap",
   "check": "A warning fires when unit TDP exceeds the selected cooling architecture maximum (air 40, rdhx 80, dlc 150, imm 200 kW).",
   "severity": "medium"
  },
  {
   "id": "R12",
   "name": "Time-to-power binding term",
   "check": "ttp equals max of power-mix, design+construction, long-lead; the named binding term is the arg-max; changing the binding input moves ttp.",
   "severity": "high"
  },
  {
   "id": "R13",
   "name": "Power mix firm coverage",
   "check": "When the mix cannot reach facility load, tPowerOut says 'never' and a red caution fires; otherwise firm MW ≥ load at the reported month.",
   "severity": "high"
  },
  {
   "id": "R14",
   "name": "LCOE closed form",
   "check": "recips at 90% CF, $40/MWh_th gas, 45% eff, $1.2M/MW, 25 yr, 8% → LCOE within ±1% of the closed-form value ($111.7/MWh at defaults).",
   "severity": "high"
  },
  {
   "id": "R15",
   "name": "Dispatch merit order",
   "check": "In the dispatch table, cheaper firm sources are used before dearer ones; mix $/MWh lies between the cheapest and dearest dispatched option's variable cost.",
   "severity": "medium"
  },
  {
   "id": "R16",
   "name": "On-site generation capex in stack",
   "check": "Selecting a template with on-site plant adds an 'On-site generation & storage' row to the CAPEX table equal to Σ MW×$/kW of eligible plant.",
   "severity": "medium"
  },
  {
   "id": "R17",
   "name": "Availability bounds",
   "check": "0.5 ≤ effective availability ≤ tier availability; manual mode uses the entered value.",
   "severity": "medium"
  },
  {
   "id": "R18",
   "name": "Provenance counting",
   "check": "Referential + baseline + scenario location-input counts sum to the number of mapped location fields; editing a preset field moves one from its class to scenario.",
   "severity": "medium"
  },
  {
   "id": "R19",
   "name": "Tornado ordering",
   "check": "Sensitivity bars sorted by |Δ$/1M tokens|; signs consistent with R7/R8 (util,tpsmw green on +20%; tariff,rcost red on +20%).",
   "severity": "medium"
  },
  {
   "id": "R20",
   "name": "Facility-mode invariance under parity",
   "check": "With facMode=single, opexMode=single, manual PUE & availability, straight-line salvage, grid-only mix, changing catalogs/templates that are bypassed must NOT move the parity figure.",
   "severity": "high"
  },
  {
   "id": "R21",
   "name": "Text integrity",
   "check": "No readout contains 'NaN','undefined','[object Object]','$undefined'; the status box always states either 'passes basic checks' or a bulleted caution list.",
   "severity": "critical"
  },
  {
   "id": "R22",
   "name": "Scenario JSON round-trip",
   "check": "Download scenario JSON captures every input id and the mix array; re-importing reproduces the same tok within rounding.",
   "severity": "medium"
  },
  {
   "id": "R23",
   "name": "Custom site round-trip",
   "check": "Preset → export jurisdiction JSON → re-import reproduces each mapped field value (self-test 'Site record round-trip').",
   "severity": "medium"
  },
  {
   "id": "R24",
   "name": "Layout no overflow",
   "check": "documentElement.scrollWidth ≤ innerWidth+1 at 390px and at desktop widths (self-test 'Layout').",
   "severity": "medium"
  },
  {
   "id": "R25",
   "name": "Testability tags complete",
   "check": "Every interactive element and readout carries the four required data-test-* attributes; reconcile(MANIFEST).pass === true.",
   "severity": "high"
  }
 ],
